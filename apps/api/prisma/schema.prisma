generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins", "typedSql"]
}

generator rotateRoles {
  provider = "node ./prisma/generators/group-role"
}

datasource db {
  provider = "postgresql"
  schemas  = ["data_administration_context", "docs", "files_context", "identity_and_access_context", "jobs", "nominations_context", "public", "reports_context", "shared_kernel_context"]
}
