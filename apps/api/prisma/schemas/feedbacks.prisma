/// the feedbacks sort on their status in this order: a status added later takes its place with ALTER TYPE ... BEFORE
enum PrismaFeedbackStatusEnum {
  NEW
  ACKNOWLEDGED
  PROCESSED
  DISMISSED

  @@map("feedback_status_enum")
  @@schema("nominations_context")
}

model Feedback {
  authorId          String                   @map("author_id") @db.Uuid
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// the account an admin was viewing the application as
  impersonatedId    String?                  @map("impersonated_id") @db.Uuid
  sentAt            DateTime                 @map("sent_at") @db.Timestamp(6)
  /// the status, comment, time and author of the last change, or NEW before any: copied here to list and filter the feedbacks
  status            PrismaFeedbackStatusEnum @default(NEW)
  statusChangedAt   DateTime?                @map("status_changed_at") @db.Timestamp(6)
  statusChangedById String?                  @map("status_changed_by") @db.Uuid
  statusComment     String?                  @map("status_comment")
  text              String
  url               String

  author          User                   @relation("feedback_author", fields: [authorId], onDelete: Cascade, onUpdate: NoAction, references: [id])
  impersonated    User?                  @relation("feedback_impersonated", fields: [impersonatedId], onDelete: SetNull, onUpdate: NoAction, references: [id])
  statusChangedBy User?                  @relation("feedback_status_changer", fields: [statusChangedById], onDelete: SetNull, onUpdate: NoAction, references: [id])
  statusChanges   FeedbackStatusChange[]

  @@map("feedback")
  @@schema("nominations_context")
}

model FeedbackStatusChange {
  changedAt  DateTime                 @map("changed_at") @db.Timestamp(6)
  changedBy  String?                  @map("changed_by") @db.Uuid
  comment    String?
  feedbackId String                   @map("feedback_id") @db.Uuid
  status     PrismaFeedbackStatusEnum

  author   User?    @relation("feedback_status_change_author", fields: [changedBy], onDelete: SetNull, onUpdate: NoAction, references: [id])
  feedback Feedback @relation(fields: [feedbackId], onDelete: Cascade, onUpdate: NoAction, references: [id])

  @@id([feedbackId, changedAt], name: "primaryKey")
  @@map("feedback_status_change")
  @@schema("nominations_context")
}
