model HelpPage {
  content     String
  page        PrismaHelpPageEnum @id
  updatedAt   DateTime           @updatedAt @map("updated_at")
  updatedById String?            @map("updated_by_id") @db.Uuid

  screenshots HelpPageScreenshot[]
  updatedBy   User?                @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("help_pages")
  @@schema("nominations_context")
}

model HelpPageScreenshot {
  detachedAt DateTime?          @map("detached_at")
  fileId     String             @map("file_id") @db.Uuid
  page       PrismaHelpPageEnum

  file     File     @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  helpPage HelpPage @relation(fields: [page], references: [page], onDelete: Cascade, onUpdate: NoAction)

  @@id([page, fileId])
  @@map("help_page_screenshots")
  @@schema("nominations_context")
}

enum PrismaHelpPageEnum {
  MEMBRE
  SECRETARIAT_GENERAL

  @@map("help_page_enum")
  @@schema("nominations_context")
}
