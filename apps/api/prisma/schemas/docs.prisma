model JusticeDepartmentContact {
  id   BigInt @id @default(autoincrement())
  name String

  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id") @db.Uuid

  officialReportVersions   OfficialReportVersion[]
  author                   User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  justicePresentationPlans JusticePresentationPlan[]

  @@map("justice_department_contact")
  @@schema("docs")
}

enum PrismaDocsFileOutcomeEnum {
  VALIDATED
  NON_VALIDATED
  SUSPENDED
  WITHDRAWN

  @@map("agenda_file_outcome_enum")
  @@schema("docs")
}

enum PrismaDocVersionStatusEnum {
  DRAFT
  VALIDATED

  @@map("doc_version_status_enum")
  @@schema("docs")
}

// #region Agenda
model Agenda {
  id                        String              @id @db.Uuid
  sessionId                 String              @map("session_id") @db.Uuid
  sessionName               String              @map("session_name")
  formation                 PrismaFormationEnum
  officialReportId          String?             @map("official_report_id") @db.Uuid
  justicePresentationPlanId String?             @map("justice_presentation_plan_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  versions                               AgendaVersion[]
  author                                 User?                                   @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "agenda_author")
  officialReport                         OfficialReport?                         @relation(fields: [officialReportId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  justicePresentationPlan                JusticePresentationPlanToAgenda?
  justicePresentationPlanNominationFiles JusticePresentationPlanNominationFile[]

  @@unique([justicePresentationPlanId, id])
  @@map("agenda")
  @@schema("docs")
}

model AgendaVersion {
  id       String                     @id @db.Uuid
  agendaId String                     @map("agenda_id") @db.Uuid
  version  Int
  status   PrismaDocVersionStatusEnum @default(DRAFT)

  date               DateTime @db.Date
  sessionMeetingDate DateTime @map("session_meeting_date") @db.Date

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  html             String?
  outdated         Boolean @default(false) @map("html_outdated")
  // computed value from all AgendaNominationFile.htmlEdited columns
  isManuallyEdited Boolean @default(false) @map("is_manually_edited")
  pdfFileId        String? @map("pdf_file_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  validatedAt DateTime? @map("validated_at")
  validatedBy String?   @map("validated_by") @db.Uuid

  nominationFiles AgendaNominationFile[]
  agenda          Agenda                 @relation(fields: [agendaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chairman        User?                  @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  author          User?                  @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "agenda_version_author")
  validator       User?                  @relation(fields: [validatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "agenda_version_validator")
  pdf             File?                  @relation("agenda_pdf_file", fields: [pdfFileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([agendaId, version])
  @@map("agenda_version")
  @@schema("docs")
}

model AgendaNominationFile {
  id               BigInt  @id @default(autoincrement())
  versionId        String  @map("version_id") @db.Uuid
  nominationFileId String? @map("nomination_file_id") @db.Uuid

  number           Int
  name             String
  grade            String
  position         String?
  targetedPosition String?                    @map("targeted_position")
  targetedGrade    String                     @map("targeted_grade")
  outcome          PrismaDocsFileOutcomeEnum?
  outcomeComment   String?                    @map("outcome_comment")
  reporters        String[]

  htmlEdited   String?   @map("html_edited")
  htmlOutdated Boolean   @default(false) @map("html_outdated")
  // when the block was last rewritten by hand, untouched by the upstream data changes
  htmlEditedAt DateTime? @map("html_edited_at")
  htmlEditedBy String?   @map("html_edited_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  version        AgendaVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination? @relation(fields: [nominationFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  editor         User?                @relation(fields: [htmlEditedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "agenda_block_editor")

  @@map("agenda_nomination_file")
  @@schema("docs")
}

// #endregion Agenda

// #region OfficialReport
model OfficialReport {
  id String @id @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id") @db.Uuid

  versions OfficialReportVersion[]
  agendas  Agenda[]
  author   User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_reports_author")

  @@map("official_report")
  @@schema("docs")
}

model OfficialReportVersion {
  id               String                     @id @db.Uuid
  officialReportId String                     @map("official_report_id") @db.Uuid
  version          Int
  status           PrismaDocVersionStatusEnum @default(DRAFT)

  sessionMeetingDate         DateTime @map("session_meeting_date") @db.Date
  sessionMeetingStartingTime DateTime @map("session_meeting_starting_time") @db.Time
  sessionMeetingEndingTime   DateTime @map("session_meeting_ending_time") @db.Time
  hasRenunciation            Boolean  @map("has_renunciation")

  justiceDepartmentContactId   BigInt? @map("justice_department_contact_id")
  justiceDepartmentContactName String  @map("justice_department_contact_name")

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  secretaryId           String?              @map("secretary_id") @db.Uuid
  secretaryFirstName    String               @map("secretary_first_name")
  secretaryLastName     String               @map("secretary_last_name")
  secretaryTitle        PrismaUserTitleEnum? @map("secretary_title")
  secretaryDisplayTitle String?              @map("secretary_display_title")
  secretaryGender       PrismaGenderEnum     @map("secretary_gender")

  introHtml          String? @map("intro_html")
  introOutdated      Boolean @default(false) @map("intro_outdated")
  conclusionHtml     String? @map("conclusion_html")
  conclusionOutdated Boolean @default(false) @map("conclusion_outdated")

  html             String?
  outdated         Boolean @default(false)
  // computed value from every manually written part of the version
  isManuallyEdited Boolean @default(false) @map("is_manually_edited")
  pdfId            String? @map("pdf_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  validatedAt DateTime? @map("validated_at")
  validatedBy String?   @map("validated_by") @db.Uuid

  members                  OfficialReportMember[]
  nominationFiles          OfficialReportNominationFile[]
  sectionTitles            OfficialReportSectionTitle[]
  sectionIntros            OfficialReportSectionIntro[]
  officialReport           OfficialReport                 @relation(fields: [officialReportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chairman                 User?                          @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_report_version_chairman")
  secretary                User?                          @relation(fields: [secretaryId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_report_version_secretary")
  author                   User?                          @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_report_version_author")
  validator                User?                          @relation(fields: [validatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_report_version_validator")
  justiceDepartmentContact JusticeDepartmentContact?      @relation(fields: [justiceDepartmentContactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pdf                      File?                          @relation(fields: [pdfId], references: [id], onDelete: Restrict, onUpdate: NoAction, name: "official_report_pdf_file")

  @@unique([officialReportId, version])
  @@map("official_report_version")
  @@schema("docs")
}

model OfficialReportMember {
  id        BigInt @id @default(autoincrement())
  versionId String @map("version_id") @db.Uuid

  isAbsent  Boolean          @map("is_absent")
  /// see User.id
  memberId  String           @map("member_id") @db.Uuid
  gender    PrismaGenderEnum
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  title     String?
  sort      Int              @db.SmallInt

  version OfficialReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("official_report_member")
  @@schema("docs")
}

model OfficialReportNominationFile {
  id        BigInt @id @default(autoincrement())
  versionId String @map("version_id") @db.Uuid

  nominationFileId String? @map("nomination_file_id") @db.Uuid

  number           Int
  name             String
  grade            String
  position         String?
  targetedPosition String?                   @map("targeted_position")
  targetedGrade    String                    @map("targeted_grade")
  outcome          PrismaDocsFileOutcomeEnum
  outcomeComment   String?                   @map("outcome_comment")
  reporters        String[]

  htmlEdited   String?   @map("html_edited")
  htmlOutdated Boolean   @default(false) @map("html_outdated")
  // when the block was last rewritten by hand, untouched by the upstream data changes
  htmlEditedAt DateTime? @map("html_edited_at")
  // the text was written in the agenda and taken as is, so the report is not the one to credit
  htmlFromAgenda Boolean @default(false) @map("html_from_agenda")
  htmlEditedBy   String? @map("html_edited_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  version        OfficialReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination?  @relation(fields: [nominationFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  editor         User?                 @relation(fields: [htmlEditedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_report_block_editor")

  @@map("official_report_nomination_file")
  @@schema("docs")
}

model OfficialReportSectionTitle {
  versionId String                    @map("version_id") @db.Uuid
  outcome   PrismaDocsFileOutcomeEnum
  title     String?

  version OfficialReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([versionId, outcome], name: "primaryKey")
  @@map("official_report_section_title")
  @@schema("docs")
}

model OfficialReportSectionIntro {
  versionId String                    @map("version_id") @db.Uuid
  outcome   PrismaDocsFileOutcomeEnum
  html      String
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  version OfficialReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([versionId, outcome], name: "primaryKey")
  @@map("official_report_section_intro")
  @@schema("docs")
}

// #endregion OfficialReport

// #region JusticePresentationPlan
model JusticePresentationPlan {
  id               String    @id @db.Uuid
  date             DateTime  @db.Date
  time             DateTime  @db.Time
  endTime          DateTime? @map("end_time") @db.Time
  html             String?
  outdated         Boolean   @default(false)
  isManuallyEdited Boolean   @default(false) @map("is_manually_edited")
  pdfId            String?   @map("pdf_id") @db.Uuid
  hasRenunciation  Boolean   @map("has_renunciation")
  isPresented      Boolean   @default(false) @map("is_presented")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  // written by the gestures a person makes, never by the html and pdf the application caches on its own
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  // null on the notices presented before the application kept that trace
  presentedAt DateTime? @map("presented_at")
  presentedBy String?   @map("presented_by") @db.Uuid

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  secretaryId           String?              @map("secretary_id") @db.Uuid
  secretaryFirstName    String               @map("secretary_first_name")
  secretaryLastName     String               @map("secretary_last_name")
  secretaryTitle        PrismaUserTitleEnum? @map("secretary_title")
  secretaryDisplayTitle String?              @map("secretary_display_title")
  secretaryGender       PrismaGenderEnum     @map("secretary_gender")

  justiceDepartmentContactId   BigInt? @map("justice_department_contact_id")
  justiceDepartmentContactName String  @map("justice_department_contact_name")

  nominationFiles JusticePresentationPlanNominationFile[]
  agendas         JusticePresentationPlanToAgenda[]
  chairman        User?                                   @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_chairman")
  secretary       User?                                   @relation(fields: [secretaryId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_secretary")
  author          User?                                   @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_author")
  editor          User?                                   @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_editor")
  presenter       User?                                   @relation(fields: [presentedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_presenter")
  justiceContact  JusticeDepartmentContact?               @relation(fields: [justiceDepartmentContactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pdf             File?                                   @relation(fields: [pdfId], references: [id], onDelete: Restrict, onUpdate: NoAction, name: "justice_presentation_pdf")
  members         JusticePresentationPlanMember[]

  @@index([isPresented])
  @@map("justice_presentation_plan")
  @@schema("docs")
}

model JusticePresentationPlanNominationFile {
  id     BigInt @id @default(autoincrement())
  planId String @map("plan_id") @db.Uuid

  nominationFileId String? @map("nomination_file_id") @db.Uuid
  agendaId         String  @map("agenda_id") @db.Uuid
  sessionId        String  @map("session_id") @db.Uuid
  sessionName      String  @map("session_name")

  number           Int
  name             String
  grade            String
  position         String?
  targetedPosition String?                   @map("targeted_position")
  targetedGrade    String                    @map("targeted_grade")
  outcome          PrismaDocsFileOutcomeEnum
  outcomeComment   String?                   @map("outcome_comment")
  reporters        String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan           JusticePresentationPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination?    @relation(fields: [nominationFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  agenda         Agenda                  @relation(fields: [agendaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("justice_presentation_plan_nomination_file")
  @@schema("docs")
}

model JusticePresentationPlanToAgenda {
  planId   String @map("plan_id") @db.Uuid
  agendaId String @unique @map("agenda_id") @db.Uuid

  comment String @default("")

  plan   JusticePresentationPlan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agenda Agenda                  @relation(fields: [planId, agendaId], references: [justicePresentationPlanId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([planId, agendaId])
  @@map("justice_presentation_plan_to_agenda")
  @@schema("docs")
}

model JusticePresentationPlanMember {
  planId   String  @map("plan_id") @db.Uuid
  /// see User.id
  memberId String  @map("member_id") @db.Uuid
  isAbsent Boolean @map("is_absent")

  plan JusticePresentationPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([planId, memberId])
  @@map("justice_presentation_plan_member")
  @@schema("docs")
}

// #endregion JusticePresentationPlan
