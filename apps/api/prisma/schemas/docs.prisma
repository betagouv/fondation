model Agenda {
  id                        String              @id @db.Uuid
  sessionId                 String              @map("session_id") @db.Uuid
  sessionName               String              @map("session_name")
  formation                 PrismaFormationEnum
  sessionMeetingDate        DateTime            @map("session_meeting_date") @db.Date
  date                      DateTime            @db.Date
  officialReportId          String?             @map("official_report_id") @db.Uuid
  justicePresentationPlanId String?             @map("justice_presentation_plan_id") @db.Uuid

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  html      String?
  pdfFileId String? @map("pdf_file_id") @db.Uuid

  nominationFiles         AgendaNominationFile[]
  chairman                User?                            @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  author                  User?                            @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "agenda_author")
  pdf                     File?                            @relation("agenda_pdf_file", fields: [pdfFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  officialReport          OfficialReport?                  @relation(fields: [officialReportId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  justicePresentationPlan JusticePresentationPlanToAgenda?

  @@unique([justicePresentationPlanId, id])
  @@map("agenda")
  @@schema("docs")
}

enum PrismaAgendaFileOutcomeEnum {
  VALIDATED
  NON_VALIDATED
  SUSPENDED
  WITHDRAWN

  @@map("agenda_file_outcome_enum")
  @@schema("docs")
}

model AgendaNominationFile {
  id               BigInt  @id @default(autoincrement())
  agendaId         String  @map("agenda_id") @db.Uuid
  nominationFileId String? @map("nomination_file_id") @db.Uuid

  number           Int
  name             String
  grade            String
  position         String?
  targetedPosition String?                     @map("targeted_position")
  targetedGrade    String                      @map("targeted_grade")
  outcome          PrismaAgendaFileOutcomeEnum
  outcomeComment   String?                     @map("outcome_comment")
  reporters        String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agenda         Agenda               @relation(fields: [agendaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination? @relation(fields: [nominationFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("agenda_nomination_file")
  @@schema("docs")
}

model OfficialReport {
  id                         String   @id @db.Uuid
  sessionMeetingDate         DateTime @map("session_meeting_date") @db.Date
  sessionMeetingStartingTime DateTime @map("session_meeting_starting_time") @db.Time
  hasRenunciation            Boolean  @map("has_renunciation")
  html                       String?
  pdfId                      String?  @map("pdf_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id") @db.Uuid
  updatedAt DateTime @updatedAt

  justiceDepartmentContactId   BigInt? @map("justice_department_contact_id")
  justiceDepartmentContactName String  @map("justice_department_contact_name")

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  secretaryId           String?              @map("secretary_id") @db.Uuid
  secretaryFirstName    String               @map("secretary_first_name")
  secretaryLastName     String               @map("secretary_last_name")
  secretaryTitle        PrismaUserTitleEnum? @map("secretary_title")
  secretaryDisplayTitle String?              @map("secretary_display_title")
  secretaryGender       PrismaGenderEnum     @map("secretary_gender")

  agendas                  Agenda[]
  members                  OfficialReportMember[]
  chairman                 User?                     @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_reports_chairman")
  secretary                User?                     @relation(fields: [secretaryId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_reports_secretary")
  author                   User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "official_reports_author")
  justiceDepartmentContact JusticeDepartmentContact? @relation(fields: [justiceDepartmentContactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pdf                      File?                     @relation(fields: [pdfId], references: [id], onDelete: Restrict, onUpdate: NoAction, name: "official_report_pdf_file")

  @@map("official_report")
  @@schema("docs")
}

model OfficialReportMember {
  id               BigInt @id @default(autoincrement())
  officialReportId String @map("official_report_id") @db.Uuid

  memberId  String?          @map("member_id") @db.Uuid
  gender    PrismaGenderEnum
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  title     String?

  officialReport OfficialReport @relation(fields: [officialReportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("official_report_member")
  @@schema("docs")
}

model JusticeDepartmentContact {
  id   BigInt @id @default(autoincrement())
  name String

  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id") @db.Uuid

  officialReports          OfficialReport[]
  author                   User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  justicePresentationPlans JusticePresentationPlan[]

  @@map("justice_department_contact")
  @@schema("docs")
}

model JusticePresentationPlan {
  id          String   @id @db.Uuid
  date        DateTime @db.Date
  time        DateTime @db.Time
  html        String?
  pdfId       String?  @map("pdf_id") @db.Uuid
  isPresented Boolean  @default(false) @map("is_presented")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  authorId  String?  @map("author_id") @db.Uuid

  chairmanId           String?              @map("chairman_id") @db.Uuid
  chairmanFirstName    String               @map("chairman_first_name")
  chairmanLastName     String               @map("chairman_last_name")
  chairmanTitle        PrismaUserTitleEnum? @map("chairman_title")
  chairmanDisplayTitle String?              @map("chairman_display_title")
  chairmanGender       PrismaGenderEnum     @map("chairman_gender")

  secretaryId           String?              @map("secretary_id") @db.Uuid
  secretaryFirstName    String               @map("secretary_first_name")
  secretaryLastName     String               @map("secretary_last_name")
  secretaryTitle        PrismaUserTitleEnum? @map("secretary_title")
  secretaryDisplayTitle String?              @map("secretary_display_title")
  secretaryGender       PrismaGenderEnum     @map("secretary_gender")

  justiceDepartmentContactId   BigInt? @map("justice_department_contact_id")
  justiceDepartmentContactName String  @map("justice_department_contact_name")

  agendas        JusticePresentationPlanToAgenda[]
  chairman       User?                             @relation(fields: [chairmanId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_chairman")
  secretary      User?                             @relation(fields: [secretaryId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_secretary")
  author         User?                             @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_author")
  justiceContact JusticeDepartmentContact?         @relation(fields: [justiceDepartmentContactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pdf            File?                             @relation(fields: [pdfId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "justice_presentation_pdf")

  @@map("justice_presentation_plan")
  @@schema("docs")
}

model JusticePresentationPlanToAgenda {
  planId   String @map("plan_id") @db.Uuid
  agendaId String @unique @map("agenda_id") @db.Uuid

  comment String @default("")

  plan   JusticePresentationPlan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agenda Agenda                  @relation(fields: [planId, agendaId], references: [justicePresentationPlanId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([planId, agendaId])
  @@map("justice_presentation_plan_to_agenda")
  @@schema("docs")
}
