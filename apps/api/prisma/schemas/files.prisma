model File {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  name            String                    @db.VarChar
  path            String[]                  @db.VarChar
  bucket          String                    @db.VarChar
  sizeInBytes     Int?                      @map("size_in_bytes") @db.Integer
  createdById     String?                   @map("created_by_id") @db.Uuid
  /// @deprecated
  storageProvider PrismaStorageProviderEnum @default(SCALEWAY) @map("storage_provider") @ignore

  agendaPdf                           AgendaVersion[]                      @relation("agenda_pdf_file")
  attachedToNominationFiles           NominationFileAttachment[]
  attachedToObservationMemberComments ObservationMemberCommentScreenshot[]
  attachedToObservations              ObservationFile[]
  attachedToReports                   ReportFile[]
  attachedToSessions                  SessionAttachment[]
  attachedToSummaries                 SummaryAttachment[]
  createdBy                           User?                                @relation("file_creator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  filePublicUrls                      FilePublicUrl[]
  includedInHelpPagesContent          HelpPageScreenshot[]
  includedInSummariesContent          SummaryScreenshot[]
  ingestionJobFile                    IngestionJobFile[]
  justicePresentationPdf              JusticePresentationPlan[]            @relation("justice_presentation_pdf")
  officialReportPdf                   OfficialReportVersion[]              @relation("official_report_pdf_file")

  @@map("files")
  @@schema("files_context")
}

model FilePublicUrl {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  expiresAt DateTime
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  fileId    String   @map("file_id") @db.Uuid

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("file_public_url")
  @@schema("files_context")
}

enum PrismaStorageProviderEnum {
  SCALEWAY

  @@map("storage_provider")
  @@schema("files_context")
}
