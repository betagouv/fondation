model File {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  name            String                    @db.VarChar
  path            String[]                  @db.VarChar
  bucket          String                    @db.VarChar
  /// @deprecated
  storageProvider PrismaStorageProviderEnum @default(SCALEWAY) @map("storage_provider") @ignore

  attachedToReports                   ReportFile[]
  attachedToSessions                  SessionAttachment[]
  filePublicUrls                      FilePublicUrl[]
  attachedToObservations              ObservationFile[]
  attachedToObservationMemberComments ObservationMemberCommentScreenshot[]
  attachedToSummaries                 SummaryAttachment[]
  includedInSummariesContent          SummaryScreenshot[]
  ingestionJobFile                    IngestionJobFile[]
  agendaPdf                           Agenda[]           @relation("agenda_pdf_file")

  @@map("files")
  @@schema("files_context")
}

model FilePublicUrl {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  expiresAt DateTime
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  fileId    String   @map("file_id") @db.Uuid

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("file_public_url")
  @@schema("files_context")
}

enum PrismaStorageProviderEnum {
  SCALEWAY

  @@map("storage_provider")
  @@schema("files_context")
}
