/// the remarks sort on their status in this order: a status added later takes its place with ALTER TYPE ... BEFORE
enum PrismaRemarkStatusEnum {
  NEW
  ACKNOWLEDGED
  PROCESSED
  DISMISSED

  @@map("remark_status_enum")
  @@schema("nominations_context")
}

model Remark {
  authorId          String                 @map("author_id") @db.Uuid
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// the account an admin was viewing the application as
  impersonatedId    String?                @map("impersonated_id") @db.Uuid
  sentAt            DateTime               @map("sent_at") @db.Timestamp(6)
  /// the status, comment, time and author of the last change, or NEW before any: copied here to list and filter the remarks
  status            PrismaRemarkStatusEnum @default(NEW)
  statusChangedAt   DateTime?              @map("status_changed_at") @db.Timestamp(6)
  statusChangedById String?                @map("status_changed_by") @db.Uuid
  statusComment     String?                @map("status_comment")
  text              String
  url               String

  author          User                 @relation("remark_author", fields: [authorId], onDelete: Cascade, onUpdate: NoAction, references: [id])
  impersonated    User?                @relation("remark_impersonated", fields: [impersonatedId], onDelete: SetNull, onUpdate: NoAction, references: [id])
  statusChangedBy User?                @relation("remark_status_changer", fields: [statusChangedById], onDelete: SetNull, onUpdate: NoAction, references: [id])
  statusChanges   RemarkStatusChange[]

  @@map("remark")
  @@schema("nominations_context")
}

model RemarkStatusChange {
  changedAt DateTime               @map("changed_at") @db.Timestamp(6)
  changedBy String?                @map("changed_by") @db.Uuid
  comment   String?
  remarkId  String                 @map("remark_id") @db.Uuid
  status    PrismaRemarkStatusEnum

  author User?  @relation("remark_status_change_author", fields: [changedBy], onDelete: SetNull, onUpdate: NoAction, references: [id])
  remark Remark @relation(fields: [remarkId], onDelete: Cascade, onUpdate: NoAction, references: [id])

  @@id([remarkId, changedAt], name: "primaryKey")
  @@map("remark_status_change")
  @@schema("nominations_context")
}
