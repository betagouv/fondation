model Observation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  nominationFileId   String                         @map("nomination_file_id") @db.Uuid
  magistratId        String                         @map("magistrat_id") @db.Uuid
  dateReception      DateTime                       @map("date_reception") @db.Date
  createdByUserId    String?                        @map("created_by_user_id") @db.Uuid
  followUp           PrismaObservationFollowUpEnum? @map("follow_up")
  followUpComment    String?                        @map("follow_up_comment")
  followedUpAt       DateTime?                      @map("followed_up_at")
  followedUpByUserId String?                        @map("followed_up_by_user_id") @db.Uuid
  description        String                         @default("")

  nominationFile DossierDeNomination        @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  magistrat      Magistrat                  @relation(fields: [magistratId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser  User?                      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "user_to_observation")
  followedUpBy   User?                      @relation(fields: [followedUpByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "user_to_observation_follow_up")
  files          ObservationFile[]
  memberComments ObservationMemberComment[]

  @@unique([nominationFileId, magistratId])
  @@index([magistratId])
  @@map("observation")
  @@schema("nominations_context")
}

model ObservationFile {
  observationId String @map("observation_id") @db.Uuid
  fileId        String @map("file_id") @db.Uuid

  originalObservationId String? @map("original_observation_id") @db.Uuid
  originalFileId        String? @map("original_file_id") @db.Uuid

  observation             Observation      @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file                    File             @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  originalObservationFile ObservationFile? @relation(fields: [originalObservationId, originalFileId], references: [observationId, fileId], onDelete: SetNull, onUpdate: NoAction, name: "observation_link")

  linkedToObservations ObservationFile[] @relation("observation_link")

  @@id([observationId, fileId])
  @@map("observation_file")
  @@schema("nominations_context")
}

// an observant is heard once per session, whatever the number of observations they made in it
model ObservantAudition {
  sessionId   String   @map("session_id") @db.Uuid
  magistratId String   @map("magistrat_id") @db.Uuid
  date        DateTime @db.Date
  time        DateTime @db.Time(0)

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  magistrat Magistrat @relation(fields: [magistratId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, magistratId], name: "primaryKey")
  @@map("observant_audition")
  @@schema("nominations_context")
}

// one row per change of the audition, never updated: who scheduled, moved or removed it and when
model ObservantAuditionVersion {
  sessionId      String    @map("session_id") @db.Uuid
  magistratId    String    @map("magistrat_id") @db.Uuid
  writtenAt      DateTime  @map("written_at")
  writtenBy      String?   @map("written_by") @db.Uuid
  /// the admin who actually wrote it while impersonating `writtenBy`
  impersonatorId String?   @map("impersonator_id") @db.Uuid
  /// both empty once the audition is removed
  date           DateTime? @db.Date
  time           DateTime? @db.Time(0)

  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  magistrat    Magistrat @relation(fields: [magistratId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author       User?     @relation(fields: [writtenBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "observant_audition_version_author")
  impersonator User?     @relation(fields: [impersonatorId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "observant_audition_version_impersonator")

  @@id([sessionId, magistratId, writtenAt])
  @@map("observant_audition_version")
  @@schema("nominations_context")
}

model ObservationMemberComment {
  userId        String    @map("user_id") @db.Uuid
  observationId String    @map("observation_id") @db.Uuid
  comment       String    @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user        User                                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  observation Observation                          @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  screenshots ObservationMemberCommentScreenshot[]

  @@id([userId, observationId], name: "primaryKey")
  @@map("observation_member_comment")
  @@schema("nominations_context")
}

model ObservationMemberCommentScreenshot {
  userId        String @map("user_id") @db.Uuid
  observationId String @map("observation_id") @db.Uuid
  fileId        String @map("file_id") @db.Uuid

  comment ObservationMemberComment @relation(fields: [userId, observationId], references: [userId, observationId], onDelete: Cascade, onUpdate: NoAction)
  file    File                     @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, observationId, fileId])
  @@map("observation_member_comment_screenshot")
  @@schema("nominations_context")
}

enum PrismaObservationFollowUpEnum {
  REFERENCE
  ALERT
  INTERESTING

  @@map("observation_follow_up_enum")
  @@schema("nominations_context")
}
