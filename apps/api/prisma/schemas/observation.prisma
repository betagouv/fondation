model Observation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  nominationFileId   String                         @map("nomination_file_id") @db.Uuid
  magistratId        String                         @map("magistrat_id") @db.Uuid
  dateReception      DateTime                       @map("date_reception") @db.Date
  createdByUserId    String?                        @map("created_by_user_id") @db.Uuid
  followUp           PrismaObservationFollowUpEnum? @map("follow_up")
  followUpComment    String?                        @map("follow_up_comment")
  followedUpAt       DateTime?                      @map("followed_up_at")
  followedUpByUserId String?                        @map("followed_up_by_user_id") @db.Uuid
  description        String                         @default("")

  nominationFile DossierDeNomination        @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  magistrat      Magistrat                  @relation(fields: [magistratId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser  User?                      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "user_to_observation")
  followedUpBy   User?                      @relation(fields: [followedUpByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "user_to_observation_follow_up")
  files          ObservationFile[]
  memberComments ObservationMemberComment[]

  @@unique([nominationFileId, magistratId])
  @@index([magistratId])
  @@map("observation")
  @@schema("nominations_context")
}

model ObservationFile {
  observationId String @map("observation_id") @db.Uuid
  fileId        String @map("file_id") @db.Uuid

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file        File        @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([observationId, fileId])
  @@map("observation_file")
  @@schema("nominations_context")
}

model ObservationMemberComment {
  userId        String    @map("user_id") @db.Uuid
  observationId String    @map("observation_id") @db.Uuid
  comment       String    @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user        User                                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  observation Observation                          @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  screenshots ObservationMemberCommentScreenshot[]

  @@id([userId, observationId], name: "primaryKey")
  @@map("observation_member_comment")
  @@schema("nominations_context")
}

model ObservationMemberCommentScreenshot {
  userId        String @map("user_id") @db.Uuid
  observationId String @map("observation_id") @db.Uuid
  fileId        String @map("file_id") @db.Uuid

  comment ObservationMemberComment @relation(fields: [userId, observationId], references: [userId, observationId], onDelete: Cascade, onUpdate: NoAction)
  file    File                     @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, observationId, fileId])
  @@map("observation_member_comment_screenshot")
  @@schema("nominations_context")
}

enum PrismaObservationFollowUpEnum {
  REFERENCE
  ALERT
  INTERESTING

  @@map("observation_follow_up_enum")
  @@schema("nominations_context")
}
