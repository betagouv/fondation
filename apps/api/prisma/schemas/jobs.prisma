enum PrismaJobStatusEnum {
  RUNNING
  FAILED
  SUCCEEDED

  @@map("status_enum")
  @@schema("jobs")
}

model IngestionJob {
  id        Int                 @id @default(autoincrement()) @db.Integer
  startedAt DateTime            @default(now()) @map("started_at")
  status    PrismaJobStatusEnum
  endedAt   DateTime?
  command   String

  reports IngestionJobReport[]

  @@map("ingestion_job")
  @@schema("jobs")
}

model IngestionJobReport {
  fileName  String
  jobId     Int      @map("job_id") @db.Integer
  createdAt DateTime @default(now())
  error     String
  metadata  Json?    @db.JsonB

  job IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([jobId, fileName])
  @@map("ingestion_job_report")
  @@schema("jobs")
}
