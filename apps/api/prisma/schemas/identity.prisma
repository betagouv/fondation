model AuthSession {
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamp(6)
  sessionId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamp(6)

  user           User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sessions_user_id_users_id_fk")
  impersonations AuthImpersonation[]

  @@map("sessions")
  @@schema("identity_and_access_context")
}

model AuthImpersonation {
  id                 String   @id @db.Uuid
  createdAt          DateTime @map("created_at")
  expiresAt          DateTime @map("expires_at")
  sessionId          String   @db.Uuid
  impersonatedUserId String   @map("impersonated_user_id") @db.Uuid

  session          AuthSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: NoAction)
  impersonatedUser User        @relation(fields: [impersonatedUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("impersonation")
  @@schema("identity_and_access_context")
}

model User {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String           @map("first_name") @db.VarChar
  lastName  String           @map("last_name") @db.VarChar
  role      PrismaRoleEnum
  email     String           @unique(map: "users_email_unique") @db.VarChar
  password  String
  gender    PrismaGenderEnum
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  sort      Int              @default(1000) @db.SmallInt

  title        PrismaUserTitleEnum? @unique()
  duty         PrismaUserDutyEnum?
  displayTitle String?              @map("display_title")

  sessions                            AuthSession[]
  excludedJurisdictionIds             ExcludedJurisdiction[]
  reporterOnNominationFileIds         NominationFileToReporter[]
  publishedVersions                   AffectationVersion[]
  commentAccess                       CommentAccess[]            @ignore
  createdObservations                 Observation[]              @relation("user_to_observation")
  observationMemberComments           ObservationMemberComment[]
  memos                               MemberMemo[]
  authorOfSummaries                   Summary[]
  readerOfSummaries                   SummaryReader[]
  followedUpObservations              Observation[]              @relation("user_to_observation_follow_up")
  validatedSessions                   Session[]
  agendas                             Agenda[]
  agendasAuthor                       Agenda[]                   @relation("agenda_author")
  authImpersonations                  AuthImpersonation[]
  authorOfJusticeDepartmentContacts   JusticeDepartmentContact[]
  chairmanOfOfficialReports           OfficialReport[]           @relation("official_reports_chairman")
  secretaryOfOfficialReports          OfficialReport[]           @relation("official_reports_secretary")
  authorOfOfficialReports             OfficialReport[]           @relation("official_reports_author")
  chairmanOfJusticePresentationPlans  JusticePresentationPlan[]  @relation("justice_presentation_chairman")
  secretaryOfJusticePresentationPlans JusticePresentationPlan[]  @relation("justice_presentation_secretary")
  authorOfJusticePresentationPlans    JusticePresentationPlan[]  @relation("justice_presentation_author")
  deletorOfSessions                   Session[]                  @relation("session_deletion_author")
  archiverOfSessions                  Session[]                  @relation("session_archive_author")

  @@map("users")
  @@schema("identity_and_access_context")
}

model OpenIdRequest {
  id        String   @db.Uuid
  provider  String
  nonce     Bytes    @db.ByteA
  challenge Bytes?   @db.ByteA
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@id([provider, id], name: "primaryKey")
  @@map("openid_request")
  @@schema("identity_and_access_context")
}

enum PrismaGenderEnum {
  MALE
  FEMALE

  @@map("gender")
  @@schema("identity_and_access_context")
}

enum PrismaRoleEnum {
  MEMBRE_DU_SIEGE
  MEMBRE_DU_PARQUET
  MEMBRE_COMMUN
  ADJOINT_SECRETAIRE_GENERAL
  ADMIN

  @@map("role")
  @@schema("identity_and_access_context")
}

enum PrismaUserTitleEnum {
  PRESIDENT_SIEGE
  PRESIDENT_PARQUET
  FIRST_SECRETARY
  DEPUTY_PRESIDENT_SIEGE
  DEPUTY_PRESIDENT_PARQUET

  @@map("user_title_enum")
  @@schema("nominations_context")
}

enum PrismaUserDutyEnum {
  PRESIDENT
  DEPUTY_PRESIDENT
  SECRETARY
  OFFICER

  @@map("user_duty_enum")
  @@schema("nominations_context")
}
