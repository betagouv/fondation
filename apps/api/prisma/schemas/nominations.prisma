model AffectationVersion {
  id                                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                            DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId                            String                      @map("session_id") @db.Uuid
  version                              Int                         @default(1)
  statut                               PrismaStatutAffectationEnum @default(BROUILLON)
  datePublication                      DateTime?                   @map("date_publication") @db.Timestamp(6)
  auteurPublicationId                  String?                     @map("auteur_publication") @db.Uuid
  /**
   * @deprecated
   */
  formation                            PrismaFormationEnum         @default(SIEGE) @ignore // now in Session
  affectations_dossiers_de_nominations Json[]                      @default([]) @ignore // now in NominationFileToReporter

  affectations NominationFileToReporter[]
  session      Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User?                      @relation(fields: [auteurPublicationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique(fields: [sessionId, version], map: "affectation_session_id_version_index")
  @@index(fields: [sessionId, version], map: "idx_affectation_session_version")
  @@map("affectation")
  @@schema("nominations_context")
}

model NominationFileToReporter {
  versionId        String   @map("version_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        AffectationVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([versionId, userId, nominationFileId], name: "primaryKey")
  @@index([nominationFileId])
  @@index([userId])
  @@map("nomination_file_to_reporter")
  @@schema("nominations_context")
}

model DossierDeNomination {
  id                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId                   String              @map("session_id") @db.Uuid
  dossierDeNominationImportId String              @unique(map: "dossier_de_nomination_dossier_de_nomination_import_id_unique") @map("dossier_de_nomination_import_id") @db.Uuid
  priorite                    PrismaPrioriteEnum?
  comment                     String?             @map("comment") @db.Text
  /**
   * @deprecated
   */
  content                     Json                @ignore

  number           Int?
  name             String?
  rank             String?
  grade            String?
  observers        String[]             @default([])
  dueDate          DateTime?            @map("due_date") @db.Date
  biography        String?
  birthDate        DateTime?            @map("birth_date") @db.Date
  formation        PrismaFormationEnum?
  currentPosition  String?              @map("current_position")
  targetedPosition String?              @map("targeted_position")
  lastRankingDate  DateTime?            @map("last_ranking_date") @db.Date
  lastPositionDate DateTime?            @map("last_position_date") @db.Date

  reports       Report[]
  reporterIds   NominationFileToReporter[]
  session       Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commentAccess CommentAccess[]

  @@map("dossier_de_nomination")
  @@schema("nominations_context")
}

model CommentAccess {
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([nominationFileId, userId])
  @@index([userId])
  @@map("comment_access")
  @@schema("nominations_context")
}

model PreAnalyse {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  dossierDeNominationId String   @unique(map: "pre_analyse_dossier_de_nomination_id_unique") @map("dossier_de_nomination_id") @db.Uuid
  regles                Json[]

  @@map("pre_analyse")
  @@schema("nominations_context")
}

model Session {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  version         Int                     @default(1)
  name            String
  formation       PrismaFormationEnum
  typeDeSaisine   PrismaTypeDeSaisineEnum @map("type_de_saisine")
  sessionImportId String                  @unique(map: "session_session_import_id_unique") @map("session_import_id")
  content         Json                    @default("{\"dateTransparence\": null, \"dateClôtureDélaiObservation\": null}")

  affectationVersions  AffectationVersion[]
  dossierDeNominations DossierDeNomination[]

  @@map("session")
  @@schema("nominations_context")
}

enum PrismaPrioriteEnum {
  ETOILE
  OUTRE_MER
  PROFILE

  @@map("priorite_enum")
  @@schema("nominations_context")
}

enum PrismaTypeDeSaisineEnum {
  TRANSPARENCE_GDS

  @@map("type_de_saisine")
  @@schema("nominations_context")
}

enum PrismaStatutAffectationEnum {
  BROUILLON
  PUBLIEE

  @@map("statut_affectation")
  @@schema("nominations_context")
}

enum PrismaFormationEnum {
  PARQUET
  SIEGE

  @@map("formation")
  @@schema("public")
}

enum PrismaTransparencyEnum {
  AUTOMNE_2024
  PROCUREURS_GENERAUX_25_NOVEMBRE_2024
  TABLEAU_GENERAL_T_DU_25_NOVEMBRE_2024
  CABINET_DU_MINISTRE_DU_21_JANVIER_2025
  SIEGE_DU_06_FEVRIER_2025
  PARQUET_DU_06_FEVRIER_2025
  PARQUET_DU_20_FEVRIER_2025
  DU_03_MARS_2025
  GRANDE_TRANSPA_DU_21_MARS_2025
  DU_30_AVRIL_2025
  MARCH_2026
  PROCUREURS_GENERAUX_8_NOVEMBRE_2024

  @@map("transparency")
  @@schema("public")
}
