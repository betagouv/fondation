model AffectationVersion {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId           String                      @map("session_id") @db.Uuid
  version             Int                         @default(1)
  statut              PrismaStatutAffectationEnum @default(BROUILLON)
  datePublication     DateTime?                   @map("date_publication") @db.Timestamp(6)
  auteurPublicationId String?                     @map("auteur_publication") @db.Uuid

  affectations NominationFileToReporter[]
  session      Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User?                      @relation(fields: [auteurPublicationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique(fields: [sessionId, version])
  @@map("affectation")
  @@schema("nominations_context")
}

model NominationFileToReporter {
  versionId        String   @map("version_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        AffectationVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([versionId, userId, nominationFileId], name: "primaryKey")
  @@index([nominationFileId])
  @@index([userId])
  @@map("nomination_file_to_reporter")
  @@schema("nominations_context")
}

enum PrismaNominationFileOutcomeEnum {
  VALIDATED
  NON_VALIDATED
  SUSPENDED
  REMOVED
  WITHDRAWN
  ASSESSING
  WAITING_DSJ

  @@map("nomination_file_outcome_enum")
  @@schema("nominations_context")
}

model DossierDeNomination {
  id             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime                         @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId      String                           @map("session_id") @db.Uuid
  //// @deprecated
  priorite       PrismaPrioriteEnum?              @ignore
  priorities     PrismaPrioriteEnum[]             @default([])
  comment        String?                          @map("comment") @db.Text
  outcome        PrismaNominationFileOutcomeEnum?
  outcomeComment String?                          @map("outcome_comment")

  number  Int?
  dueDate DateTime? @map("due_date") @db.Date

  // Nomination
  rank             String?
  targetedGrade    String? @map("targeted_grade")
  currentPosition  String? @map("current_position")
  targetedPosition String? @map("targeted_position")

  /// @deprecated
  observers String[] @default([])

  // Magistrat
  name              String
  grade             String?
  biography         String?
  birthDate         DateTime? @map("birth_date") @db.Date
  lastRankingDate   DateTime? @map("last_ranking_date") @db.Date
  lastPositionDate  DateTime? @map("last_position_date") @db.Date
  careerInformation String?   @map("career_information")

  /// might be temporary
  alertHidden Boolean @default(false) @map("alert_hidden")

  externalId            Int?                     @map("external_id")
  sortableTargetedGrade Int                      @map("sortable_targeted_grade") @db.SmallInt
  search                Unsupported("tsvector")? @default(dbgenerated("to_tsvector('unaccent_fr'::regconfig, lower(name))"))

  detectedMagistratId        String? @map("detected_magistrat_id") @db.Uuid
  detectedJurisdictionId     String? @map("detected_jurisdiction_id")
  detectedTargetedFunctionId String? @map("detected_targeted_function_id")
  detectedTargetedPositionId Int?    @map("detected_targeted_position_id")

  reports                    Report[]
  reporterIds                NominationFileToReporter[]
  session                    Session                                 @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commentAccess              CommentAccess[]                         @ignore
  observations               Observation[]
  memberMemos                MemberMemo[]
  summary                    Summary?
  attachments                NominationFileAttachment[]
  agendaInclusions           AgendaNominationFile[]
  presentationPlanInclusions JusticePresentationPlanNominationFile[]
  officialReportInclusions   OfficialReportNominationFile[]

  detectedMagistrat        Magistrat?    @relation(fields: [detectedMagistratId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  detectedJurisdiction     Jurisdiction? @relation(fields: [detectedJurisdictionId], references: [codejur], onDelete: SetNull, onUpdate: NoAction)
  detectedTargetedFunction Function?     @relation(fields: [detectedTargetedFunctionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  detectedTargetedPosition Position?     @relation(fields: [detectedTargetedPositionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([sessionId, externalId], name: "sessionExternalId")
  @@index([sessionId, sortableTargetedGrade])
  @@index([search], map: "nomination_file_search_idx_gin", type: Gin)
  @@map("dossier_de_nomination")
  @@schema("nominations_context")
}

model NominationFileAttachment {
  nominationFileId String @map("nomination_file_id") @db.Uuid
  fileId           String @map("file_id") @db.Uuid

  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file           File                @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([nominationFileId, fileId], name: "primaryKey")
  @@map("nomination_file_attachment")
  @@schema("nominations_context")
}

/// @deprecated
model CommentAccess {
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([nominationFileId, userId])
  @@index([userId])
  @@map("comment_access")
  @@ignore
  @@schema("nominations_context")
}

model Session {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  version                 Int                     @default(1)
  name                    String
  formation               PrismaFormationEnum
  typeDeSaisine           PrismaTypeDeSaisineEnum @map("type_de_saisine")
  sessionImportId         String                  @unique(map: "session_session_import_id_unique") @map("session_import_id")
  date                    DateTime                @db.Date
  observationsClosingDate DateTime                @map("observations_closing_date") @db.Date
  dueDate                 DateTime?               @map("due_date") @db.Date
  positionStartDate       DateTime?               @map("position_start_date") @db.Date
  lolfiSessionId          Int?                    @map("lolfi_session_id")
  isValidated             Boolean                 @default(false) @map("is_validated")
  validatedBy             String?                 @map("validated_by") @db.Uuid
  validatedAt             DateTime?               @map("validated_at")

  // wee need to keep the session since LOLFI could update an existing session
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  archivedAt DateTime? @map("archived_at")
  archivedBy String?   @map("archived_by") @db.Uuid

  affectationVersions  AffectationVersion[]
  dossierDeNominations DossierDeNomination[]
  attachments          SessionAttachment[]
  validator            User?                 @relation(fields: [validatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletionAuthor       User?                 @relation(fields: [deletedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "session_deletion_author")
  archiver             User?                 @relation(fields: [archivedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, name: "session_archive_author")

  @@index([deletedAt])
  @@index([archivedAt])
  @@map("session")
  @@schema("nominations_context")
}

model SessionAttachment {
  sessionId String @map("session_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, fileId])
  @@map("session_attachment")
  @@schema("nominations_context")
}

model MemberMemo {
  userId           String    @map("user_id") @db.Uuid
  nominationFileId String    @map("nomination_file_id") @db.Uuid
  memo             String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, nominationFileId], name: "primaryKey")
  @@map("member_memo")
  @@schema("nominations_context")
}

model Summary {
  nominationFileId String   @id @map("nomination_file_id") @db.Uuid
  authorId         String?  @map("author_id") @db.Uuid
  content          String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  readers        SummaryReader[]
  screenshots    SummaryScreenshot[]
  attachments    SummaryAttachment[]

  @@map("summaries")
  @@schema("nominations_context")
}

model SummaryReader {
  summaryId String   @map("summary_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, summaryId])
  @@map("summary_readers")
  @@schema("nominations_context")
}

model SummaryAttachment {
  summaryId String @map("summary_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)

  @@id([summaryId, fileId])
  @@map("summary_attachments")
  @@schema("nominations_context")
}

model SummaryScreenshot {
  summaryId String @map("summary_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)

  @@id([summaryId, fileId])
  @@map("summary_screenshots")
  @@schema("nominations_context")
}

enum PrismaPrioriteEnum {
  ETOILE
  OUTRE_MER
  PROFILE

  @@map("priorite_enum")
  @@schema("nominations_context")
}

enum PrismaTypeDeSaisineEnum {
  TRANSPARENCE_GDS

  @@map("type_de_saisine")
  @@schema("nominations_context")
}

enum PrismaStatutAffectationEnum {
  BROUILLON
  PUBLIEE

  @@map("statut_affectation")
  @@schema("nominations_context")
}

enum PrismaFormationEnum {
  PARQUET
  SIEGE

  @@map("formation")
  @@schema("public")
}
