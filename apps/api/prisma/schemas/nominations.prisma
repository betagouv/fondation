model AffectationVersion {
  id                                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                            DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId                            String                      @map("session_id") @db.Uuid
  version                              Int                         @default(1)
  statut                               PrismaStatutAffectationEnum @default(BROUILLON)
  datePublication                      DateTime?                   @map("date_publication") @db.Timestamp(6)
  auteurPublicationId                  String?                     @map("auteur_publication") @db.Uuid
  /// @deprecated
  formation                            PrismaFormationEnum         @default(SIEGE) @ignore // now in Session
  /// @deprecated
  affectations_dossiers_de_nominations Json[]                      @default([]) @ignore // now in NominationFileToReporter

  affectations NominationFileToReporter[]
  session      Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User?                      @relation(fields: [auteurPublicationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique(fields: [sessionId, version], map: "affectation_session_id_version_index")
  @@index(fields: [sessionId, version], map: "idx_affectation_session_version")
  @@map("affectation")
  @@schema("nominations_context")
}

model NominationFileToReporter {
  versionId        String   @map("version_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        AffectationVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([versionId, userId, nominationFileId], name: "primaryKey")
  @@index([nominationFileId])
  @@index([userId])
  @@map("nomination_file_to_reporter")
  @@schema("nominations_context")
}

enum PrismaNominationFileOutcomeEnum {
  VALIDATED
  NON_VALIDATED
  SUSPENDED
  REMOVED
  WITHDRAWN
  ASSESSING
  WAITING_DSJ

  @@map("nomination_file_outcome_enum")
  @@schema("nominations_context")
}

model DossierDeNomination {
  id                          String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                   DateTime                         @default(now()) @map("created_at") @db.Timestamp(6)
  sessionId                   String                           @map("session_id") @db.Uuid
  /// @deprecated
  dossierDeNominationImportId String                           @unique(map: "dossier_de_nomination_dossier_de_nomination_import_id_unique") @map("dossier_de_nomination_import_id") @db.Uuid
  //// @deprecated
  priorite                    PrismaPrioriteEnum?              @ignore
  priorities                  PrismaPrioriteEnum[]             @default([])
  comment                     String?                          @map("comment") @db.Text
  outcome                     PrismaNominationFileOutcomeEnum?
  outcomeComment              String?                          @map("outcome_comment")

  /// @deprecated
  content Json @default(dbgenerated("'{}'::JSONB")) @db.JsonB

  number            Int?
  name              String
  rank              String?
  targetedGrade     String?   @map("targeted_grade")
  grade             String?
  observers         String[]  @default([])
  biography         String?
  birthDate         DateTime? @map("birth_date") @db.Date
  currentPosition   String?   @map("current_position")
  targetedPosition  String?   @map("targeted_position")
  lastRankingDate   DateTime? @map("last_ranking_date") @db.Date
  lastPositionDate  DateTime? @map("last_position_date") @db.Date
  careerInformation String?   @map("career_information")
  /// might be temporary
  alertHidden       Boolean   @default(false) @map("alert_hidden")
  /// @deprecated
  dueDate           DateTime? @map("due_date") @db.Date

  sortableTargetedGrade Int @map("sortable_targeted_grade") @db.SmallInt

  reports       Report[]
  reporterIds   NominationFileToReporter[]
  session       Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commentAccess CommentAccess[]
  observations  Observation[]
  memberMemos   MemberMemo[]
  summary       Summary?

  @@unique([sessionId, number], name: "sessionFileNumber")
  @@index([sessionId, sortableTargetedGrade])
  @@map("dossier_de_nomination")
  @@schema("nominations_context")
}

model CommentAccess {
  nominationFileId String   @map("nomination_file_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([nominationFileId, userId])
  @@index([userId])
  @@map("comment_access")
  @@schema("nominations_context")
}

model PreAnalyse {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  dossierDeNominationId String   @unique(map: "pre_analyse_dossier_de_nomination_id_unique") @map("dossier_de_nomination_id") @db.Uuid
  regles                Json[]

  @@map("pre_analyse")
  @@schema("nominations_context")
}

model Session {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  version                 Int                     @default(1)
  name                    String
  formation               PrismaFormationEnum
  typeDeSaisine           PrismaTypeDeSaisineEnum @map("type_de_saisine")
  sessionImportId         String                  @unique(map: "session_session_import_id_unique") @map("session_import_id")
  date                    DateTime                @db.Date
  observationsClosingDate DateTime                @map("observations_closing_date") @db.Date
  dueDate                 DateTime?               @map("due_date") @db.Date
  positionStartDate       DateTime?               @map("position_start_date") @db.Date
  /// @deprecated
  content                 Json                    @default("{\"dateTransparence\": null, \"dateClôtureDélaiObservation\": null}") @ignore

  affectationVersions  AffectationVersion[]
  dossierDeNominations DossierDeNomination[]
  attachments          SessionAttachment[]

  @@map("session")
  @@schema("nominations_context")
}

model SessionAttachment {
  sessionId String @map("session_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, fileId])
  @@map("session_attachment")
  @@schema("nominations_context")
}

model MemberMemo {
  userId           String    @map("user_id") @db.Uuid
  nominationFileId String    @map("nomination_file_id") @db.Uuid
  memo             String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, nominationFileId], name: "primaryKey")
  @@map("member_memo")
  @@schema("nominations_context")
}

model Summary {
  nominationFileId String   @id @map("nomination_file_id") @db.Uuid
  authorId         String?  @map("author_id") @db.Uuid
  content          String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  nominationFile DossierDeNomination @relation(fields: [nominationFileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  readers        SummaryReader[]
  screenshots    SummaryScreenshot[]
  attachments    SummaryAttachment[]

  @@map("summaries")
  @@schema("nominations_context")
}

model SummaryReader {
  summaryId String   @map("summary_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, summaryId])
  @@map("summary_readers")
  @@schema("nominations_context")
}

model SummaryAttachment {
  summaryId String @map("summary_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)

  @@id([summaryId, fileId])
  @@map("summary_attachments")
  @@schema("nominations_context")
}

model SummaryScreenshot {
  summaryId String @map("summary_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid

  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  summary Summary @relation(fields: [summaryId], references: [nominationFileId], onDelete: Cascade, onUpdate: NoAction)

  @@id([summaryId, fileId])
  @@map("summary_screenshots")
  @@schema("nominations_context")
}

enum PrismaPrioriteEnum {
  ETOILE
  OUTRE_MER
  PROFILE

  @@map("priorite_enum")
  @@schema("nominations_context")
}

enum PrismaTypeDeSaisineEnum {
  TRANSPARENCE_GDS

  @@map("type_de_saisine")
  @@schema("nominations_context")
}

enum PrismaStatutAffectationEnum {
  BROUILLON
  PUBLIEE

  @@map("statut_affectation")
  @@schema("nominations_context")
}

enum PrismaFormationEnum {
  PARQUET
  SIEGE

  @@map("formation")
  @@schema("public")
}

enum PrismaTransparencyEnum {
  AUTOMNE_2024
  PROCUREURS_GENERAUX_25_NOVEMBRE_2024
  TABLEAU_GENERAL_T_DU_25_NOVEMBRE_2024
  CABINET_DU_MINISTRE_DU_21_JANVIER_2025
  SIEGE_DU_06_FEVRIER_2025
  PARQUET_DU_06_FEVRIER_2025
  PARQUET_DU_20_FEVRIER_2025
  DU_03_MARS_2025
  GRANDE_TRANSPA_DU_21_MARS_2025
  DU_30_AVRIL_2025
  MARCH_2026
  PROCUREURS_GENERAUX_8_NOVEMBRE_2024

  @@map("transparency")
  @@schema("public")
}
