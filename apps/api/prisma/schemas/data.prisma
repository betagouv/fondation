model ExcludedJurisdiction {
  userId         String @map("user_id") @db.Uuid
  jurisdictionId String @map("jurisdiction_id")

  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [codejur], onDelete: Cascade, onUpdate: NoAction, map: "excluded_jurisdictions_jurisdiction_id_jurisdictions_codejur_fk")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "excluded_jurisdictions_user_id_users_id_fk")

  @@id([userId, jurisdictionId], map: "excluded_jurisdictions_user_id_jurisdiction_id_pk")
  @@map("excluded_jurisdictions")
  @@schema("data_administration_context")
}

model Jurisdiction {
  codejur         String    @id
  typeJur         String    @map("type_jur")
  adr1            String?
  adr2            String?
  arrondissement  String?
  codepos         String?
  dateSuppression DateTime? @map("date_suppression") @db.Date
  libelle         String?
  ressort         String?
  ville_jur       String?
  ville           String?

  excludedByUserIds ExcludedJurisdiction[]

  @@map("jurisdictions")
  @@schema("data_administration_context")
}

/// @deprecated - use nominations_context.dossier_de_nomination
model NominationFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  row_number Int
  content    Json
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@map("nomination_files")
  @@schema("data_administration_context")
}

/// @deprecated - use nominations_context.session_attachment
model TransparenceFile {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transparence_id String       @db.Uuid
  file_id         String       @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  files           File         @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transparence_files_file_id_files_id_fk")
  transparences   Transparence @relation(fields: [transparence_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transparence_files_transparence_id_transparences_id_fk")

  @@map("transparence_files")
  @@schema("data_administration_context")
}

/// @deprecated - use nominations_context.session
model Transparence {
  id                             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String
  created_at                     DateTime            @default(now()) @db.Timestamp(6)
  formation                      PrismaFormationEnum
  nomination_files               Json[]
  date_transparence              DateTime            @db.Timestamp(6)
  date_echeance                  DateTime?           @db.Timestamp(6)
  date_prise_de_poste            DateTime?           @db.Timestamp(6)
  date_cloture_delai_observation DateTime            @db.Timestamp(6)
  transparence_files             TransparenceFile[]

  @@unique([name, formation, date_transparence], map: "transparences_name_formation_date_transparence_unique")
  @@map("transparences")
  @@schema("data_administration_context")
}

model JurisdictionType {
  id    String @id @db.Char(4)
  label String
  sort  Int

  @@index([sort])
  @@map("jurisdiction_type")
  @@schema("data_administration_context")
}

model Grade {
  grade       String  @id
  label       String
  sort        Int     @db.SmallInt
  massGradeId String? @map("mass_grade_id")

  massGrade Grade?  @relation(fields: [massGradeId], references: [grade], onDelete: SetNull, onUpdate: NoAction, name: "parentGrade")
  grades    Grade[] @relation("parentGrade")

  @@index([sort])
  @@map("grade")
  @@schema("data_administration_context")
}

model Function {
  id        String              @id
  sort      Int                 @db.SmallInt
  formation PrismaFormationEnum
  addition  String?

  label              String
  label_one_male     String?
  label_one_female   String?
  label_other_male   String?
  label_other_female String?

  @@index([sort])
  @@map("function")
  @@schema("data_administration_context")
}

model Pause {
  id    String  @id
  rate  Float
  label String?

  @@map("pause")
  @@schema("data_administration_context")
}
