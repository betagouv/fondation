model MagistratPhoneNumber {
  id          String   @id @db.Uuid
  magistratId String   @map("magistrat_id") @db.Uuid
  number      String
  label       String?
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamp(3)

  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  magistrat Magistrat @relation(fields: [magistratId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([magistratId, number])
  @@map("magistrat_phone_number")
  @@schema("nominations_context")
}
