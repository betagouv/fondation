DATABASE_URL=postgresql://fondation:secret@localhost:5435/fondation_test
E2E_API_TOKEN=jeton-e2e-de-test
NODE_OPTIONS=--experimental-vm-modules

INBOUND_ALLOWED_API_TOKENS=jeton-machine-de-test

# bcrypt at its minimum cost: the e2e do not check the strength of the hashes
PASSWORD_HASH_COST=4

# the e2e deactivate one magistrat out of two: no share of them reads as an incomplete extraction.
# lolfi-incomplete-extraction.e2e-spec.ts starts its own api with a threshold
LOLFI_MAX_DEACTIVATION_RATIO=1
