{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "scalingo"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "start": "tsc -p tsconfig.build.json && dotenvx run -- node dist/main.js",
    "start:e2e": "env -u NODE_V8_COVERAGE tsc -p tsconfig.build.json && dotenvx run -f .env.e2e -f .env -- node dist/main.e2e.js",
    "predev": "pnpm prisma:generate",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & dotenvx run -- node --watch dist/main.js)",
    "start:debug": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & dotenvx run -- node --inspect --watch dist/main.js)",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma": "dotenvx run -- prisma",
    "prisma:generate": "dotenvx run -- prisma generate --sql",
    "sentry": "sentry-cli",
    "local:empty-except-accounts": "dotenvx run -f .env -- node scripts/empty-local-or-staging-except-accounts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/lib-storage": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@dotenvx/dotenvx": "1.75.1",
    "@nestjs-cls/transactional": "3.3.1",
    "@nestjs-cls/transactional-adapter-prisma": "1.4.1",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.76.0",
    "axios": "1.20.0",
    "axios-retry": "4.5.0",
    "bcrypt": "6.0.0",
    "cheerio": "1.2.0",
    "common-tags": "1.8.2",
    "cookie-parser": "1.4.7",
    "date-fns": "4.4.0",
    "documents-assets": "workspace:*",
    "exif-be-gone": "1.5.1",
    "nest-commander": "3.21.0",
    "nestjs-cls": "6.3.1",
    "nestjs-zod": "5.5.0",
    "node-xlsx": "0.24.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sax": "1.6.1",
    "unzipper": "0.12.5",
    "xlsx": "file:../../vendor/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@nestjs/testing": "11.2.7",
    "@prisma/generator-helper": "7.10.0",
    "@sentry/cli": "3.8.0",
    "@types/bcrypt": "6.0.0",
    "@types/common-tags": "1.8.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/inquirer": "8.2.13",
    "@types/multer": "2.3.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/sax": "1.2.7",
    "@types/unzipper": "0.10.11",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "c8": "12.0.0",
    "jszip": "3.10.2",
    "lolfi": "workspace:*",
    "prisma": "7.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  }
}
