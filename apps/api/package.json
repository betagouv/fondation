{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "scalingo"
  ],
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "start": "dotenvx run -- nest start",
    "start:e2e": "dotenvx run -f .env.e2e -f .env -- nest start",
    "dev": "dotenvx run -- nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "types:check": "tsc --noEmit",
    "test": "jest --config ./test/jest/jest.config.ts",
    "test:e2e": "dotenvx run -f .env.e2e -f .env -- jest --runInBand --config ./test/jest/jest-e2e.config.ts",
    "test:all": "dotenvx run -f .env.e2e -f .env -- jest --runInBand --config ./test/jest/jest-all.config.ts",
    "cli": "dotenvx run -- ts-node -r tsconfig-paths/register src/cli.ts",
    "prisma": "dotenvx run -- prisma",
    "sentry": "sentry-cli",
    "postinstall": "node node_modules/puppeteer/install.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/lib-storage": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@dotenvx/dotenvx": "1.52.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.40.0",
    "axios": "^1.13.6",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "common-tags": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "exif-be-gone": "^1.5.1",
    "nest-commander": "^3.20.1",
    "nestjs-zod": "^5.1.1",
    "node-xlsx": "^0.24.0",
    "pg": "^8.19.0",
    "piscina": "^5.1.4",
    "puppeteer": "^24.39.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sax": "^1.4.4",
    "shared-models": "workspace:*",
    "unzipper": "^0.12.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.14",
    "@prisma/generator-helper": "^6.19.2",
    "@sentry/cli": "^3.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/common-tags": "^1.8.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.15",
    "@types/pg": "^8.16.0",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^7.2.0",
    "@types/unzipper": "^0.10.11",
    "expect": "^30.2.0",
    "jest": "^30.2.0",
    "jszip": "^3.10.1",
    "prisma": "6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "wait-for-expect": "^4.0.0"
  }
}
