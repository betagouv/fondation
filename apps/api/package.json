    "@prisma/generator-helper": "6.19.3",
    "@sentry/cli": "3.4.2",
    "@types/bcrypt": "6.0.0",
    "@types/common-tags": "1.8.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/inquirer": "8.2.12",
    "@types/jest": "30.0.0",
    "@types/multer": "2.1.0",
    "@types/node": "24.12.4",
