    "@dotenvx/dotenvx": "1.52.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.22",
    "@nestjs/core": "11.1.22",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.1.22",
    "@nestjs/swagger": "11.4.4",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@sentry/node": "10.53.1",
    "axios": "1.16.1",
    "axios-retry": "4.5.0",
    "bcrypt": "6.0.0",
    "cheerio": "1.2.0",
    "common-tags": "1.8.2",
    "cookie-parser": "1.4.7",
    "date-fns": "4.2.1",
    "exif-be-gone": "1.5.1",
    "nest-commander": "3.20.1",
    "nestjs-zod": "5.4.0",
    "node-xlsx": "0.24.0",
    "pg": "8.21.0",
    "piscina": "5.1.4",
    "puppeteer": "24.43.1",
