[sqlfluff]
dialect = postgres
max_line_length = 110

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2
indent_size = 2
indented_joins = True

[sqlfluff:rules:layout.operators]
line_position = leading

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
ignore_words = formation, role, gender, storage_provider, file_type, type_de_saisine, statut_affectation, transparency, rule_group, rule_name, reports_state, domain_event_status
ignore_words_regex = '_enum$'

[sqlfluff:rules:structure.join_condition_order]
preferred_first_table_in_join_clause = later

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = c_style

[sqlfluff:rules:references.quoting]
prefer_quoted_identifiers = False
prefer_quoted_keywords = True

[sqlfluff:layout:type:data_type]
spacing_within = touch:inline
