root /app/dist;

location / {
  add_header X-Content-Type-Options "nosniff";
  add_header X-Frame-Options "DENY";
  add_header Cache-Control "no-store";
  try_files $uri /index.html;
}

location /api/ {
  return 404;
}

location /assets/ {
  add_header Cache-Control "public, max-age=2592000, immutable"; # 30 days
  try_files $uri =404;
}

# Ad blockers and network proxies may drop calls to the Sentry domain. The browser IP is not forwarded, as with sendDefaultPii: false
location = /monitoring {
  proxy_pass https://sentry.incubateur.net/api/235/envelope/;
  proxy_set_header Cookie "";
  proxy_set_header X-Forwarded-For "";
  proxy_set_header X-Real-IP "";
  proxy_ssl_server_name on;
}
