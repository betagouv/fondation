{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 110,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": {
    "sortSideEffects": false,
    "order": "asc",
    "ignoreCase": true,
    "newlinesBetween": true,
    "groups": [
      "value-builtin",
      ["value-external", "type-external", "value-import", "type-import"],
      ["value-internal", "type-internal", "value-parent", "type-parent"],
      ["value-sibling", "type-sibling"],
      "unknown"
    ]
  }
}
