{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ESNext",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "incremental": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "./test/**/*", "./fictitious-archive/**/*"]
}
