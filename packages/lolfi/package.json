{
  "name": "lolfi",
  "private": true,
  "version": "1.0.0",
  "description": "LOLFI archive generator shared between the API tests and the front-end",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "types:check": "tsc --noEmit -p .",
    "build": "tsc -p tsconfig.build.json",
    "generate:fictitious-archive": "tsc -p tsconfig.fictitious-archive.json && node .fictitious-archive/fictitious-archive/generate-fictitious-archive.js",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "date-fns": "4.4.0",
    "jszip": "3.10.2"
  }
}
