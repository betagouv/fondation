{
  "name": "lolfi",
  "private": true,
  "version": "1.0.0",
  "description": "LOLFI archive generator shared between the API tests and the front-end",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "types:check": "tsc --noEmit -p .",
    "build": "tsc -p tsconfig.build.json",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "test": "node --test --require @swc-node/register test/*.test.ts"
  },
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "date-fns": "4.2.1",
    "jszip": "3.10.1"
  }
}
