{
  "name": "fondation",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "lint:check": "oxlint",
    "format:check": "oxfmt --check",
    "types:check": "pnpm run -r types:check",
    "openapi:generate": "pnpm run -r openapi:generate",
    "build": "pnpm run -r build",
    "prepush": "pnpm --filter lolfi build; pnpm lint:check; pnpm --filter client lint:colors; pnpm format:check; pnpm types:check",
    "scalingo-postbuild": "echo 'App already built. Disable build phase with envvar NPM_NO_BUILD=true'",
    "heroku-postbuild": "echo 'App already built'",
    "lint": "oxlint"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.62.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  }
}
