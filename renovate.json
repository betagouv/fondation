{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "commitMessagePrefix": "chore(FON-000):",
  "dependencyDashboard": true,
  "schedule": ["after 6am and before 8pm on Sunday"],
  "pinDigests": true,
  "minimumReleaseAge": "15 days",
  "prConcurrentLimit": 1,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1
  }
}
