{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "FON-000",
  "commitMessageLowerCase": "never",
  "commitMessageAction": "update",
  "dependencyDashboard": {
    "enabled": true
  },
  "schedule": ["after 6am and before 8pm on Sunday"],
  "pinDigests": true,
  "minimumReleaseAge": "15 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "toolSettings": {
    "nodeMaxMemory": 2048
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1
  },
  "lockFileMaintenance": {
    "description": "On the first Sunday of the month, in the slot of the other updates",
    "enabled": true,
    "schedule": ["* 6-19 1-7 * 0"]
  },
  "packageRules": [
    {
      "description": "zod 4.5+ emits `type: [X, 'null']` for nullable fields, which nestjs-zod 5.5 turns into `type: 'array'`, even in OpenAPI 3.1",
      "matchPackageNames": ["zod"],
      "allowedVersions": "<4.5.0"
    },
    {
      "description": "nest-commander 3 brings inquirer 8, which ships no types, and requires @types/inquirer 8: version 9 types inquirer 9 and version 10 is an empty stub",
      "matchPackageNames": ["@types/inquirer"],
      "allowedVersions": "<9"
    },
    {
      "matchFileNames": ["apps/api/package.json", "apps/api-e2e/package.json"],
      "groupName": "api",
      "additionalBranchPrefix": "api/"
    },
    {
      "matchFileNames": ["apps/client/package.json"],
      "groupName": "client",
      "additionalBranchPrefix": "client/"
    },
    {
      "matchFileNames": ["packages/**/package.json"],
      "groupName": "packages",
      "additionalBranchPrefix": "packages/"
    },
    {
      "description": "The tools, the catalog and the overrides shared by the whole repository, updated every week in one PR",
      "matchFileNames": ["package.json", "pnpm-workspace.yaml"],
      "groupName": "workspace",
      "additionalBranchPrefix": "workspace/"
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "docker",
      "additionalBranchPrefix": "docker/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github",
      "additionalBranchPrefix": "github/"
    },
    {
      "description": "pnpm is pinned both in `packageManager` and in the CI: both move together",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "additionalBranchPrefix": ""
    },
    {
      "allowedVersions": "<18",
      "description": "PostgreSQL follows the major version of the Scalingo production database",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"]
    },
    {
      "description": "The application groups go before the tooling updates, which used to take every slot",
      "matchFileNames": [
        "apps/api/package.json",
        "apps/api-e2e/package.json",
        "apps/client/package.json",
        "packages/**/package.json"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "prPriority": 1
    },
    {
      "description": "A major update always needs work: it opens only once ticked in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The workspace has a single pnpm-lock.yaml: one branch refreshes it instead of one per group",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "all",
      "additionalBranchPrefix": "",
      "prPriority": 1
    }
  ]
}
