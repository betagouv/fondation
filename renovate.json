{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "FON-000",
  "commitMessageLowerCase": "never",
  "commitMessageAction": "update",
  "dependencyDashboard": true,
  "schedule": ["after 6am and before 8pm on Sunday"],
  "pinDigests": true,
  "minimumReleaseAge": "15 days",
  "prConcurrentLimit": 5,
  "toolSettings": {
    "nodeMaxMemory": 2048
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1
  },
  "lockFileMaintenance": {
    "description": "On the first Sunday of the month, in the slot of the other updates",
    "enabled": true,
    "schedule": ["* 6-19 1-7 * 0"]
  },
  "packageRules": [
    {
      "description": "zod 4.5+ emits `type: [X, 'null']` for nullable fields, which nestjs-zod 5.5 turns into `type: 'array'`, even in OpenAPI 3.1",
      "matchPackageNames": ["zod"],
      "allowedVersions": "<4.5.0"
    },
    {
      "matchFileNames": ["apps/api/package.json", "apps/api-e2e/package.json"],
      "groupName": "api",
      "additionalBranchPrefix": "api/"
    },
    {
      "matchFileNames": ["apps/client/package.json"],
      "groupName": "client",
      "additionalBranchPrefix": "client/"
    },
    {
      "matchFileNames": ["packages/**/package.json"],
      "groupName": "packages",
      "additionalBranchPrefix": "packages/"
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "docker",
      "additionalBranchPrefix": "docker/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github",
      "additionalBranchPrefix": "github/"
    },
    {
      "allowedVersions": "<18",
      "description": "PostgreSQL follows the major version of the Scalingo production database",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"]
    }
  ]
}
